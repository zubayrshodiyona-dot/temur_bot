      "source": [
        "import difflib\n",
        "\n",
        "# Amir Temur va Temur Tuzuklari bo'yicha kengaytirilgan ma'lumotlar bazasi\n",
        "knowledge_base = {\n",
        "    \"temur tuzuklari nima\": \"Temur Tuzuklari — Amir Temur tomonidan yozilgan davlat boshqaruvi, qonun-qoidalar, harbiy san'at va saltanat tuzumiga bag'ishlangan buyuk tarixiy-adabiy yodgorlikdir.\",\n",
        "    \"amir temur kim\": \"Amir Temur (Tamerlan) — buyuk sarkarda, davlat arbobi, Temuriylar imperiyasining asoschisi, ilm-fan, madaniyat va me'morchilik homiysi.\",\n",
        "    \"tug'ilgan yili\": \"Amir Temur 1336-yil 9-aprelda Kesh (Shahrisabz) yaqinidagi Xoja Ilg'or qishlog'ida tavallud topgan.\",\n",
        "    \"kelib chiqishi\": \"Amir Temur barlos turkiy qabilasining beklaridan bo'lib, uning otasi Amir Tarag'ay davlat arbobi va ulamolarning homiysi bo'lgan.\",\n",
        "    \"vafoti\": \"Amir Temur 1405-yil 18-fevralda O'tror shahrida Xitoyga yurish vaqtida vafot etgan. Uning xoki Samarqanddagi Go'ri Amir maqbarasiga qo'yilgan.\",\n",
        "    \"oilasi va ayollari\": \"Amir Temurning bosh xotini Saroymulkxonim (Katta xonim) bo'lib, u Chingizxon avlodidan edi.\",\n",
        "    \"farzandlari\": \"Amir Temurning asosiy o'g'illari: Umarshayx, Jahongir, Mironshoh va Shohrux mirzo.\",\n",
        "    \"adolat haqida\": \"Amir Temurning asosiy shiori: 'Kuch – adolatdadir'. U davlatni boshqarishda qonun ustuvorligiga va adolatga alohida e'tibor qaratgan.\",\n",
        "    \"davlat boshqaruvi\": \"Temur Tuzuklariga ko'ra, davlat ishlarining o'n dan to'qqiz qismi kengash, tadbir va mashvarat bilan, qolgan bir qismi esa qilich va qat'iyat bilan amalga oshirilgan.\",\n",
        "    \"farovonlik\": \"Amir Temur o'z saltanatida: 'O'z saltanimda jabr-zulmga uchragan biror kishi qolmasin' deb, xalq farovonligini birinchi o'ringa qo'ygan.\",\n",
        "    \"armiya tuzilishi\": \"Amir Temur qo'shini o'nlik, yuzlik, minglik va o'n minglik (tuman) tizimiga bo'lingan.\",\n",
        "    \"anqara jangi\": \"1402-yilda Anqara jangida Usmonli sultoni Boyazid Yildirim ustidan g'alaba qozongan.\",\n",
        "    \"poytaxt\": \"Amir Temur saltanatining poytaxti — ilm-fan va madaniyat markaziga aylantirilgan Samarqand shahri bo'lgan.\"\n",
        "}\n",
        "\n",
        "def ai_assistant(user_question):\n",
        "    user_question = user_question.lower()\n",
        "    questions = list(knowledge_base.keys())\n",
        "    match = difflib.get_close_matches(user_question, questions, n=1, cutoff=0.2)\n",
        "\n",
        "    if match:\n",
        "        return knowledge_base[match[0]]\n",
        "    else:\n",
        "        return \"Kechirasiz, bu savol bo'yicha hozircha bazamda ma'lumot yo'q.\"\n",
        "\n",
        "print(\"--- Temur Tuzuklari AI Yordamchisiga Xush Kelibsiz! ---\")\n",
        "while True:\n",
        "    q = input(\"\\nSavol bering (chiqish uchun 'exit' yozing): \")\n",
        "    if q.lower() == 'exit':\n",
        "        break\n",
        "    answer = ai_assistant(q)\n",
        "    print(\"AI Javobi:\", answer)"
      ],
